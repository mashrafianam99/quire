{
  "name": "quire",
  "version": "1.0.0",
  "description": "Quire - a free, open-source PDF editor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.4",
    "libheif-js": "^1.23.5",
    "mupdf": "^1.28.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8",
    "wordnet-db": "^3.1.14"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "electron/main.mjs",
  "build": {
    "appId": "org.quire.editor",
    "productName": "Quire",
    "copyright": "AGPL-3.0-or-later",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
